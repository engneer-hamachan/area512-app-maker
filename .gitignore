# Compiled apps
*.mrb
*.mpy

# Emulator screenshots
screenshots/*
!screenshots/.gitkeep

# Dependencies and local settings
node_modules/
.env
.DS_Store
.claude/settings.local.json

# Work files of /area512-work-flow: plans, reference images, reports
workflow-runs/

# Game definitions other than the template
game-definitions/*
!game-definitions/template.md

# Bots other than snake (the workflow writes probe bots here)
bots/*
!bots/snake.mjs

# Apps other than snake
apps/*
!apps/snake/
