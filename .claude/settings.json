{
  "permissions": {
    "allow": [
      "Bash(docker compose *)",
      "Bash(mkdir -p workflow-runs/*)",
      "Bash(curl -fsSL --max-filesize 5000000 -o workflow-runs/*)",
      "WebSearch",
      "WebFetch",
      "Edit(apps/**)",
      "Edit(bots/**)",
      "Edit(workflow-runs/**)",
      "mcp__picoruby-ti",
      "mcp__picoruby-ti-2432s028"
    ],
    "deny": [
      "mcp__picoruby-ti__diagnostic",
      "mcp__picoruby-ti-2432s028__diagnostic"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 3600
          }
        ]
      }
    ]
  },
  "env": {
    "MCP_TIMEOUT": "1800000"
  }
}
